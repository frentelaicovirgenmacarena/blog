rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Regla de Oro:
      // Cualquiera puede ver (read) los iconos sagrados.
      // Solo el Administrador puede subir (write) nuevas reliquias.
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'frentelaicovirgenmacarena@gmail.com';
    }
  }
}
